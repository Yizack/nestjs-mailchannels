{
  "name": "nestjs-mailchannels",
  "version": "0.1.2",
  "description": "NestJS module for the MailChannels Email API",
  "keywords": [
    "email",
    "mailchannels",
    "nestjs",
    "transactional"
  ],
  "homepage": "https://github.com/mailchannels/nestjs-mailchannels",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mailchannels/nestjs-mailchannels.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "node --run build",
    "playground:start": "cd playground && pnpm start",
    "test:types": "tsc --noEmit",
    "test": "node --run build && node --run test:types && vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "checks": "node --run test && node --run test:types &&node --run lint && node --run format",
    "release": "node --run checks && changelogen --release --push --no-github",
    "release:github": "changelogen gh release"
  },
  "dependencies": {
    "@mailchannels/sdk": "^1.9.1",
    "@nestjs/common": "^12.5.0"
  },
  "devDependencies": {
    "@nestjs/core": "^12.5.0",
    "@types/node": "^26.6.6",
    "changelogen": "^0.6.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "reflect-metadata": "^0.2.2",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.18.0"
}
